  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:dev:android": "npx -y eas-cli@latest build --profile development --platform android",
    "build:dev:ios": "npx -y eas-cli@latest build --profile development --platform ios",
    "build:preview:android": "npx -y eas-cli@latest build --profile preview --platform android",
    "build:preview:ios": "npx -y eas-cli@latest build --profile preview --platform ios",
    "update:preview": "npx -y eas-cli@latest update --channel preview --environment preview --platform android --message",
