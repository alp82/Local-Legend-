# The fantasy tile worker's credentials. Copy to worker.env on the host, fill in, and
# chmod 600. Never commit the filled-in file.
#
# The worker signs in as the renderer user: an auth user whose app_metadata has
# "fantasy_renderer": true (docs/fantasy-map-deploy.md, step 2). It may only lease, finish
# and queue fantasy tiles, read their status, and write the fantasy-tiles bucket. It does
# NOT need the service key.

SUPABASE_URL=https://bvnlepwccygdkgsezgka.supabase.co
# The publishable key the app ships with (public; Dashboard > Project Settings > API Keys).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
FANTASY_RENDERER_EMAIL=fantasy-renderer@...
FANTASY_RENDERER_PASSWORD=...
